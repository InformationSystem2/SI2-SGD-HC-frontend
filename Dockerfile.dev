# Stage 1: Development
FROM node:22-alpine

WORKDIR /app

# Cache dependencies
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Angular development port
EXPOSE 4200

# Start development server with host binding
# --host 0.0.0.0 is required for Docker access
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
